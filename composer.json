{
    "name": "ipsocode/hypervel-cin7",
    "description": "Cin7 Core API client for Hypervel, built on hypervel/saloon",
    "license": "MIT",
    "keywords": [
        "hypervel",
        "cin7",
        "dear",
        "inventory",
        "saloon",
        "coroutine"
    ],
    "require": {
        "ext-json": "*",
        "hypervel/components": "0.4.x-dev"
    },
    "require-dev": {
        "brianium/paratest": "^7.24",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.0",
        "hypervel/testbench": "^0.4",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0.3",
        "symfony/yaml": "^8.0.12"
    },
    "autoload": {
        "psr-4": {
            "Ipsocode\\Cin7\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ipsocode\\Cin7\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "hypervel": {
            "providers": [
                "Ipsocode\\Cin7\\Cin7ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": false
        },
        "platform": {
            "ext-swoole": "6.2.3"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/php-cs-fixer fix --diff --dry-run",
        "lint:fix": "@php vendor/bin/php-cs-fixer fix",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit 1G -c phpstan.neon",
        "conventions": "@php .github/scripts/conventions.php",
        "test": "@php vendor/bin/testbench package:test",
        "test:phpunit": "@php vendor/bin/phpunit",
        "test:parallel": "@php vendor/bin/testbench package:test --parallel",
        "test:coverage": "@php vendor/bin/testbench package:test --parallel --coverage --coverage-clover tests/coverage/clover.xml --min=100",
        "test:purge": "@php vendor/bin/testbench package:purge-skeleton"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan at level 5 over src/ \u2014 the level hypervel/components uses.",
        "lint": "Report coding-standard violations without changing anything.",
        "lint:fix": "Apply the coding standard in .php-cs-fixer.dist.php.",
        "test": "Run the package suite through the Testbench CLI.",
        "test:phpunit": "Run the package suite through PHPUnit directly, bypassing the Testbench CLI.",
        "test:parallel": "Run the package suite through ParaTest.",
        "test:coverage": "Run the package suite through ParaTest with PCOV coverage, failing under 100%. Needs the PCOV extension, which the CI image has.",
        "test:purge": "Clear cached config, routes, views and runtime SQLite files from the Testbench skeleton."
    }
}
